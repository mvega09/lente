# Copiar a /etc/systemd/system/ y ejecutar:
#   sudo systemctl daemon-reload && sudo systemctl enable --now lente-worker
[Unit]
Description=LENTE worker de IA (Ollama)
After=network-online.target

[Service]
User=useria
WorkingDirectory=/home/useria/lente
EnvironmentFile=/home/useria/lente/.env
ExecStart=/home/useria/lente/.venv/bin/python -m worker.ia_worker
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
