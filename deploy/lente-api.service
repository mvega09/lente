# Copiar a /etc/systemd/system/ y ejecutar:
#   sudo systemctl daemon-reload && sudo systemctl enable --now lente-api
# Escucha en todas las interfaces (0.0.0.0:8000) para que el frontend, que
# desarrolla otra persona, llegue a la API por la red interna/VPN.
[Unit]
Description=LENTE API (FastAPI)
Wants=network-online.target
After=network-online.target

[Service]
User=useria
WorkingDirectory=/home/useria/lente
EnvironmentFile=/home/useria/lente/.env
ExecStart=/home/useria/lente/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
