# Copie este archivo como .env y cambie los valores. El .env nunca se sube a GitHub.

ENTORNO=desarrollo

# PostgreSQL (VM-BD)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lente
DB_APP_USER=lente_app
DB_APP_PASSWORD=cambie_esta_clave
DB_IA_USER=lente_ia
DB_IA_PASSWORD=cambie_esta_clave

# Sesiones (JWT). Genere uno con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRETO=cambie_este_secreto
JWT_MINUTOS=480

# Orígenes permitidos para el frontend, separados por coma en formato JSON
CORS_ORIGENES=["http://localhost:3000"]

# Ollama (VM-IA)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO_VALIDACION=qwen3:4b
OLLAMA_MODELO_PREPARACION=qwen3:14b
OLLAMA_KEEP_ALIVE=30m
# El modelo de validación queda siempre cargado (-1m): cargarlo toma ~30 s
OLLAMA_KEEP_ALIVE_VALIDACION=-1m
# Límite duro por solicitud a Ollama (segundos); al superarse, el trabajo se reintenta
OLLAMA_TIMEOUT_REVISION_S=90
OLLAMA_TIMEOUT_PREPARACION_S=900
